# Biomedical Knowledge Lookup Environment Variables

# Some knowledge sources require API keys. 
# Get them from the respective providers and add them here.
# Rename this file to .env and fill in your keys.

# BioPortal API Key (Required for BioPortal, BioOntology)
# Get one at: https://bioportal.bioontology.org/account
BIOPORTAL_API_KEY=your_bioportal_key_here

# UMLS API Key (Required for UMLS)
# Get one at: https://uts.nlm.nih.gov/uts/signup-login
UMLS_API_KEY=your_umls_key_here

# ChEMBL API Token (Optional, for higher rate limits)
# Get one at: https://www.ebi.ac.uk/chembl/
CHEMBL_API_TOKEN=your_chembl_token_here

# DisGeNET API Key (Required for DisGeNET)
# Get one at: https://www.disgenet.org/
DISGENET_API_KEY=your_disgenet_key_here

# OMIM API Key (Required for OMIM)
# Request one at: https://www.omim.org/api
OMIM_API_KEY=your_omim_key_here

# COSMIC credentials (Required for COSMIC; there is no keyless API)
# Register at https://cancer.sanger.ac.uk/cosmic/register, then set this to
# base64("email:password"), e.g.  printf '%s' 'email:password' | base64
COSMIC_API_KEY=your_base64_email_password_here

# WHO ICD-11 API credentials (Required for ICD-11; free registration at https://icd.who.int/icdapi)
ICD11_CLIENT_ID=your_icd11_client_id_here
ICD11_CLIENT_SECRET=your_icd11_client_secret_here

# LOINC account (Required for LOINC; free account at https://loinc.org)
LOINC_USERNAME=your_loinc_username_here
LOINC_PASSWORD=your_loinc_password_here

# Local data files (optional; each adapter's docs page explains what to put here)
# ICD10GM_CLAML_PATH=/path/to/icd10gm_claml.xml   # or ICD10GM_URL / ICD10GM_YEAR / ICD10GM_MEMBER
# SEMMEDDB_PATH=/path/to/semmeddb.sqlite   # build it with: knowledge-lookup semmeddb-build <PREDICATION.sql.gz> -o <file>
# HPOA_PATH=/path/to/phenotype.hpoa
# SIDER_DATA_DIR=/path/to/sider/
# OFFSIDES_PATH=/path/to/OFFSIDES.csv.gz
# CELLMARKER_PATH=/path/to/Cell_marker_Human.xlsx  # or CELLMARKER_URL
# CTD_DATA_DIR=/path/to/ctd_reports/

# Bulk dataset downloads are opt-in: dataset-backed sources are skipped until their data is on
# disk or you allow the download. Per source: HPOA_DOWNLOAD (~36 MB), SIDER_DOWNLOAD (~5.5 MB),
# OFFSIDES_DOWNLOAD (~69 MB), CTD_DOWNLOAD (~220 MB core reports). Or allow all of them:
# KNOWLEDGE_LOOKUP_ALLOW_DOWNLOADS=1
# KNOWLEDGE_LOOKUP_DATA_DIR=~/.cache/knowledge_lookup/datasets   # where downloads are kept
# CTD_DOWNLOAD_GENES=1 / CTD_DOWNLOAD_GENES_DISEASES=1   # optional CTD files (123 MB / 3.2 GB)

# Optional API keys / polite-pool settings for the keyless public services
# NCBI_API_KEY=       # dbSNP and MedGen (E-utilities): raises 3 -> 10 requests/s
# NCBI_EMAIL=         # sent to E-utilities if set
# OPENFDA_API_KEY=    # openFDA events and drug labels: daily quota 1,000 -> 120,000
# OPENALEX_API_KEY=   # OpenAlex: a free key raises the daily credit budget tenfold
# OPENALEX_MAILTO=    # optional OpenAlex polite-pool address (nothing is sent if unset)
# GTEX_DATASET_ID=gtex_v10   # or gtex_v8

# ClinGen and GenCC publish only CSV exports, so they are opt-in like the other datasets
# CLINGEN_DOWNLOAD=1 (~1.4 MB) / CLINGEN_PATH / CLINGEN_DOSAGE_PATH
# GENCC_DOWNLOAD=1 (~28 MB) / GENCC_PATH

# Optional contact addresses / tokens for polite pools and higher limits (nothing is sent if unset)
# CROSSREF_MAILTO=            # Crossref polite pool
# MEDLINEPLUS_EMAIL=          # sent as the MedlinePlus web service's email parameter
# OPENCITATIONS_ACCESS_TOKEN=
# SEMANTIC_SCHOLAR_API_KEY=   # keyless search is almost always rate limited (HTTP 429)

# Other new-source settings (all optional)
# CLINICALTABLES_TABLES=icd10cm,conditions,loinc_items,hpo   # NLM Clinical Tables to search
# PANELAPP_API_BASE=https://panelapp.genomicsengland.co.uk/api/v1   # or PanelApp Australia
# EQTLCATALOGUE_RELEASE=r7    # or r8_beta

# Other service settings (all optional)
# ICD11_API_BASE=http://localhost:8382  # self-hosted WHO ICD-API container (no token needed)
# ICD11_RELEASE=2025-01
# ICD11_LANGUAGE=en
# SNOMED_SNOWSTORM_URL=https://your-snowstorm.example/snowstorm/snomed-ct
# SNOMED_SNOWSTORM_BRANCH=MAIN

# Other optional configuration
CACHE_DIR=./cache
CACHE_ENABLED=True
TIMEOUT_PER_SOURCE=10.0
MAX_RESULTS_PER_SOURCE=20
LOG_LEVEL=INFO
