# Biomedical Knowledge Lookup Environment Variables

# Some knowledge sources require API keys. 
# Get them from the respective providers and add them here.
# Rename this file to .env and fill in your keys.

# BioPortal API Key (Required for BioPortal, BioOntology)
# Get one at: https://bioportal.bioontology.org/account
BIOPORTAL_API_KEY=your_bioportal_key_here

# UMLS API Key (Required for UMLS)
# Get one at: https://uts.nlm.nih.gov/uts/signup-login
UMLS_API_KEY=your_umls_key_here

# ChEMBL API Token (Optional, for higher rate limits)
# Get one at: https://www.ebi.ac.uk/chembl/
CHEMBL_API_TOKEN=your_chembl_token_here

# DisGeNET API Key (Required for DisGeNET)
# Get one at: https://www.disgenet.org/
DISGENET_API_KEY=your_disgenet_key_here

# OMIM API Key (Required for OMIM)
# Request one at: https://www.omim.org/api
OMIM_API_KEY=your_omim_key_here

# COSMIC credentials (Required for COSMIC; there is no keyless API)
# Register at https://cancer.sanger.ac.uk/cosmic/register, then set this to
# base64("email:password"), e.g.  printf '%s' 'email:password' | base64
COSMIC_API_KEY=your_base64_email_password_here

# WHO ICD-11 API credentials (Required for ICD-11; free registration at https://icd.who.int/icdapi)
ICD11_CLIENT_ID=your_icd11_client_id_here
ICD11_CLIENT_SECRET=your_icd11_client_secret_here

# LOINC account (Required for LOINC; free account at https://loinc.org)
LOINC_USERNAME=your_loinc_username_here
LOINC_PASSWORD=your_loinc_password_here

# Local data files (optional; the adapters explain what to put here)
# ICD10GM_CLAML_PATH=/path/to/icd10gm_claml.xml
# SEMMEDDB_PATH=/path/to/semmeddb.sqlite

# Other optional configuration
CACHE_DIR=./cache
CACHE_ENABLED=True
TIMEOUT_PER_SOURCE=10.0
MAX_RESULTS_PER_SOURCE=20
LOG_LEVEL=INFO
